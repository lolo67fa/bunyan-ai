{
  "$description": "Bunyan design tokens. Source: approved identity (direction C, calm green). Mirror of src/styles/tokens.css. Contrast ratios are against #FFFFFF.",
  "color": {
    "bg":           { "light": "#FFFFFF", "dark": "#121514", "use": "Page background" },
    "bg-subtle":    { "light": "#FAFAF8", "dark": "#171B19", "use": "Side bar, quiet panels" },
    "selected":     { "light": "#ECEAE5", "dark": "#242A27", "use": "Selected item" },
    "border":       { "light": "#EAE8E3", "dark": "#2B302E", "use": "Borders and dividers" },
    "text":         { "light": "#1C1F1E", "dark": "#ECEEEC", "use": "Primary text", "contrast": "16.6:1" },
    "text-2":       { "light": "#3F4441", "dark": "#C7CCC9", "use": "Body text", "contrast": "9.9:1" },
    "text-muted":   { "light": "#6B6F6C", "dark": "#A4AAA7", "use": "Secondary and helper text", "contrast": "5.1:1" },
    "accent":       { "light": "#0F6E62", "dark": "#4CC2B0", "use": "Primary action and links", "contrast": "6.1:1" },
    "accent-hover": { "light": "#0C5C52", "dark": "#6FD1C2", "use": "Hover state of accent" },
    "accent-soft":  { "light": "#E8F3F1", "dark": "#15302B", "use": "Focus ring fill, soft accent backgrounds" },
    "brand":        { "light": "#168477", "dark": "#4CC2B0", "use": "Logo green block only" },
    "brand-ink":    { "light": "#14403A", "dark": "#ECEEEC", "use": "Logo dark blocks only" },
    "success":      { "light": "#1E7A43", "dark": "#6BCB8E", "use": "Done, passed", "contrast": "5.4:1" },
    "warning":      { "light": "#9A5B00", "dark": "#E8B25A", "use": "Waiting for your action", "contrast": "5.4:1" },
    "danger":       { "light": "#B42318", "dark": "#FF8A7D", "use": "Error, failed", "contrast": "6.6:1" },
    "success-soft": { "light": "#EDF6F0", "dark": "#14241A", "use": "Success notice background" },
    "warning-soft": { "light": "#FDF7EA", "dark": "#2A2213", "use": "Waiting notice background" },
    "danger-soft":  { "light": "#FDF0EE", "dark": "#2C1714", "use": "Error notice background" }
  },
  "font": {
    "sans": "IBM Plex Sans Arabic (Arabic and English UI)",
    "mono": "IBM Plex Mono (code, file names, Latin digits in data)",
    "scale": {
      "display": { "size": 28, "weight": 600, "use": "Marketing page title" },
      "title":   { "size": 22, "weight": 600, "use": "Screen title" },
      "section": { "size": 15, "weight": 600, "use": "Section heading" },
      "body":    { "size": 14, "weight": 400, "lineHeight": 1.7, "use": "Body text" },
      "small":   { "size": 13, "weight": 400, "use": "Secondary text" },
      "mono":    { "size": 13, "weight": 400, "use": "Code and file names" }
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "control": 6, "badge": 8, "window": 10 },
  "height": { "control": 40, "controlLarge": 44 },
  "logo": {
    "module": "Three blocks of 10 units with a 2-unit joint on a 22 x 22 grid, corner radius 1.6",
    "rule": "The green block sits on the base, on the side that faces the wordmark (left in Arabic, right in English). No gradients, no shadows.",
    "clearSpace": "One block (10 units) on every side",
    "minimumSize": { "mark": "16px", "lockup": "88px wide" }
  }
}

{
  "$description": "Bunyan design tokens. Colours: the approved Riyadh visual theme (PR #13). Mirror of src/styles/tokens.css. Light contrast ratios are against #FFFFFF; dark ratios against #0B0D1F.",
  "palette": {
    "midnight": {
      "value": "#0B0D1F",
      "use": "Night page ground; dark theme background"
    },
    "navy": {
      "value": "#121634",
      "use": "Raised sections; dark quiet panels"
    },
    "indigo": {
      "value": "#1E1B4B",
      "use": "Cards on dark; dark selected item"
    },
    "purple": {
      "value": "#3B1E6E",
      "use": "Deep purple glow"
    },
    "violet": {
      "value": "#7C6BB0",
      "use": "Lines and borders on hover"
    },
    "lavender": {
      "value": "#C9BFF2",
      "use": "Accent on dark; landing primary button"
    },
    "silver": {
      "value": "#B8BCCB",
      "use": "Secondary text on dark"
    },
    "gold": {
      "value": "#E3C998",
      "use": "Champagne: small details only (numbers, coordinates, rules)"
    },
    "ink": {
      "value": "#17123A",
      "use": "Text on light; text on lavender"
    }
  },
  "color": {
    "bg": {
      "light": "#FFFFFF",
      "dark": "#0B0D1F",
      "use": "Page background"
    },
    "bg-subtle": {
      "light": "#F8F7FC",
      "dark": "#121634",
      "use": "Side bar, quiet panels"
    },
    "selected": {
      "light": "#ECE8F8",
      "dark": "#1E1B4B",
      "use": "Selected item"
    },
    "border": {
      "light": "#E6E2F2",
      "dark": "#262A4D",
      "use": "Borders and dividers"
    },
    "text": {
      "light": "#17123A",
      "dark": "#F4F2FA",
      "use": "Primary text",
      "contrast": "17.7:1"
    },
    "text-2": {
      "light": "#3B3560",
      "dark": "#C8C4DA",
      "use": "Body text",
      "contrast": "11.3:1"
    },
    "text-muted": {
      "light": "#676184",
      "dark": "#9692AE",
      "use": "Secondary and helper text",
      "contrast": "5.8:1"
    },
    "accent": {
      "light": "#5B3FA8",
      "dark": "#C9BFF2",
      "use": "Primary action and links",
      "contrast": "7.7:1"
    },
    "accent-hover": {
      "light": "#4A3290",
      "dark": "#DDD6FB",
      "use": "Hover state of accent"
    },
    "accent-soft": {
      "light": "#EFEBFB",
      "dark": "#241F52",
      "use": "Focus ring fill, soft accent backgrounds"
    },
    "highlight": {
      "light": "#8A6A2F",
      "dark": "#E3C998",
      "use": "Champagne gold for small details only",
      "contrast": "5.0:1"
    },
    "brand": {
      "light": "#168477",
      "dark": "#4CC2B0",
      "use": "Logo green block only"
    },
    "brand-ink": {
      "light": "#14403A",
      "dark": "#ECEEEC",
      "use": "Logo dark blocks only"
    },
    "success": {
      "light": "#1E7A43",
      "dark": "#6BCB8E",
      "use": "Done, passed",
      "contrast": "5.4:1"
    },
    "warning": {
      "light": "#9A5B00",
      "dark": "#E8B25A",
      "use": "Waiting for your action",
      "contrast": "5.4:1"
    },
    "danger": {
      "light": "#B42318",
      "dark": "#FF8A7D",
      "use": "Error, failed",
      "contrast": "6.6:1"
    },
    "success-soft": {
      "light": "#EDF6F0",
      "dark": "#13262A",
      "use": "Success notice background"
    },
    "warning-soft": {
      "light": "#FDF7EA",
      "dark": "#2A2218",
      "use": "Waiting notice background"
    },
    "danger-soft": {
      "light": "#FDF0EE",
      "dark": "#2C1724",
      "use": "Error notice background"
    }
  },
  "font": {
    "sans": "IBM Plex Sans Arabic (Arabic and English UI)",
    "mono": "IBM Plex Mono (code, file names, Latin digits in data)",
    "scale": {
      "display": {
        "size": 28,
        "weight": 600,
        "use": "Marketing page title"
      },
      "title": {
        "size": 22,
        "weight": 600,
        "use": "Screen title"
      },
      "section": {
        "size": 15,
        "weight": 600,
        "use": "Section heading"
      },
      "body": {
        "size": 14,
        "weight": 400,
        "lineHeight": 1.7,
        "use": "Body text"
      },
      "small": {
        "size": 13,
        "weight": 400,
        "use": "Secondary text"
      },
      "mono": {
        "size": 13,
        "weight": 400,
        "use": "Code and file names"
      }
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "control": 6,
    "badge": 8,
    "window": 10
  },
  "height": {
    "control": 40,
    "controlLarge": 44
  },
  "logo": {
    "module": "Three blocks of 10 units with a 2-unit joint on a 22 x 22 grid, corner radius 1.6",
    "rule": "The green block sits on the base, on the side that faces the wordmark (left in Arabic, right in English). No gradients, no shadows.",
    "clearSpace": "One block (10 units) on every side",
    "minimumSize": {
      "mark": "16px",
      "lockup": "88px wide"
    }
  }
}

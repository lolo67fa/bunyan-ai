# Copy to .env.local (git-ignored). Never put LLM API keys here — the frontend never calls models.

# "mock" = in-browser fake backend built on the Business Analyst sample outputs
# "http" = the real FastAPI backend (Alanoud)
VITE_API_MODE=mock

# Used only when VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8000

# Polling interval for GET /projects/{id}, in milliseconds
VITE_POLL_MS=2000

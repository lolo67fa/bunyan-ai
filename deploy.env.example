# BUNYAN AI: settings for the club deployment (Docker / Railway).
# Copy to deploy.env for docker compose, or enter these as service variables on the
# hosting platform. NEVER commit real keys or real password hashes.

# ---------- Access (required) ----------
# Every page and API route needs a login. One entry per tester, comma separated.
# Create each entry with:  python -m backend.security hash-password <name>
BUNYAN_AUTH=required
BUNYAN_USERS=

# ---------- Limits ----------
# write requests per user
BUNYAN_MAX_REQUESTS_PER_MINUTE=20
BUNYAN_MAX_PROJECTS_PER_USER_PER_DAY=10
# analyses + answer rounds + change requests
BUNYAN_MAX_ANALYSES_PER_USER_PER_DAY=12
# all users together, real model only
BUNYAN_MAX_LLM_ANALYSES_PER_DAY=40
BUNYAN_MAX_CONCURRENT_ANALYSES=2

# ---------- Business Analyst ----------
# mock: free demo ideas only. llm: real analysis, every analysis is a paid request.
BA_MODE=mock
# For BA_MODE=llm (set the key as a platform secret, not in a file):
# BA_LLM_PROVIDER=anthropic
# BA_LLM_MODEL=claude-opus-5-5
# BA_LLM_BACKEND=direct
# ANTHROPIC_API_KEY=
# One paid request per analysis, capped:
BA_MAX_RETRIES=0
BA_SDK_MAX_RETRIES=0
BA_FALLBACKS=off
BA_MAX_TOKENS=32000
BA_REQUEST_TIMEOUT=300
BA_EFFORT=high

# ---------- QA ----------
BUNYAN_QA=on

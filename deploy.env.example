# BUNYAN AI: settings for the club deployment (Docker / Railway).
# Copy to deploy.env for docker compose, or enter these as service variables on the
# hosting platform. NEVER commit real keys or real password hashes.

# ---------- Access ----------
# required: every page and API route needs a login from BUNYAN_USERS (one entry per
#           tester, comma separated; create each with: python -m backend.security hash-password <name>)
# guest:    no login. Each visitor gets an anonymous guest identity in a signed, HttpOnly,
#           Secure, SameSite=Lax cookie; guests only see their own projects. Needs
#           BUNYAN_SESSION_SECRET (at least 32 characters) and BA_MODE=mock.
BUNYAN_AUTH=required
BUNYAN_USERS=
# BUNYAN_SESSION_SECRET=
# Only for local http testing of guest mode; keep true (the default) behind HTTPS.
# BUNYAN_COOKIE_SECURE=true

# ---------- Limits ----------
# write requests per user
BUNYAN_MAX_REQUESTS_PER_MINUTE=20
BUNYAN_MAX_PROJECTS_PER_USER_PER_DAY=10
# analyses + answer rounds + change requests
BUNYAN_MAX_ANALYSES_PER_USER_PER_DAY=12
# all users together, real model only
BUNYAN_MAX_LLM_ANALYSES_PER_DAY=40
BUNYAN_MAX_CONCURRENT_ANALYSES=2
# Against new guest cookies: per address and for the whole site
# BUNYAN_MAX_REQUESTS_PER_MINUTE_PER_IP=60
# BUNYAN_MAX_PROJECTS_PER_IP_PER_DAY=40
# BUNYAN_MAX_PROJECTS_PER_DAY=300
# BUNYAN_MAX_NEW_SESSIONS_PER_IP_PER_HOUR=30

# ---------- Business Analyst ----------
# mock: free demo ideas only. llm: real analysis, every analysis is a paid request.
BA_MODE=mock
# For BA_MODE=llm (set the key as a platform secret, not in a file):
# BA_LLM_PROVIDER=anthropic
# BA_LLM_MODEL=claude-opus-5-5
# BA_LLM_BACKEND=direct
# ANTHROPIC_API_KEY=
# One paid request per analysis, capped:
BA_MAX_RETRIES=0
BA_SDK_MAX_RETRIES=0
BA_FALLBACKS=off
BA_MAX_TOKENS=32000
BA_REQUEST_TIMEOUT=300
BA_EFFORT=high

# ---------- QA ----------
BUNYAN_QA=on

# ---------- Protected real Business Analyst (optional, off by default) ----------
# Guests stay on BA_MODE=mock. A guest who enters an access code gets the real analyst for that
# browser session only. Codes are hashed: python -m backend.security hash-password <label>
# and the prompt asks for the code itself. Keep the key and the codes in the platform's variables.
# BUNYAN_LLM_ACCESS=codes
# BUNYAN_LLM_ACCESS_CODES=club:pbkdf2:...
# BUNYAN_LLM_MAX_PER_CODE_PER_DAY=3
# BUNYAN_LLM_DAILY_BUDGET_USD=2          # checked against the worst case before every request
# BUNYAN_LLM_MAX_INPUT_TOKENS=20000      # worst-case input used for that reservation
# BUNYAN_LLM_ACCESS_HOURS=12
# BA_LLM_PROVIDER=anthropic
# BA_LLM_MODEL=claude-opus-5-5
# BA_LLM_BACKEND=direct
# ANTHROPIC_API_KEY=                     # set it in the platform, never here
# (BA_MAX_RETRIES=0, BA_SDK_MAX_RETRIES=0, BA_FALLBACKS=off and BA_MAX_TOKENS<=32000 are required)
# Repair loop: "restore" (default, deterministic, no LLM) or "off".
# BUNYAN_REPAIR=restore

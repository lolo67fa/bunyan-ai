# BUNYAN AI — environment variables
# Copy this file to `.env` and fill in your own values locally.
# NEVER commit `.env` or real credentials to Git.

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=
# Model name for the selected provider
LLM_MODEL=

# API key for the selected provider (only one is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# BUNYAN AI — environment variables
# Copy this file to `.env` and fill in your own values locally.
# NEVER commit `.env` or real credentials to Git.

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=
# Model name for the selected provider
LLM_MODEL=

# API key for the selected provider (only one is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Business Analyst in the running app (backend/main.py)
# ---------------------------------------------------------------------------
# "mock" (default): free, offline, answers only the built-in demo ideas and ignores
#                   requested changes.
# "llm": real analysis of any CRUD idea by the model below. Every analysis, answer
#        round and change request is a paid API call. Never enabled automatically.
# Any other value stops the backend at startup with a clear error. A failing model is
# reported to the user; the app never falls back to mock on its own.
BA_MODE=mock

# For BA_MODE=llm with the small direct backend (no CrewAI):
#   pip install -r backend/agents/business_analyst/requirements-direct.txt
#   BA_LLM_PROVIDER=anthropic
#   BA_LLM_MODEL=claude-opus-5-5
#   BA_LLM_BACKEND=direct
#   ANTHROPIC_API_KEY=...            (above; never commit it)
# Cost controls (see backend/agents/business_analyst/.env.example for all options):
#   BA_MAX_RETRIES=1        extra paid attempt when the answer fails validation (default 2)
#   BA_SDK_MAX_RETRIES=0    no SDK retries on 429/5xx (default 2)
#   BA_FALLBACKS=off        no second, billed attempt on another model after a refusal
#   BA_MAX_TOKENS=32000     output cap per request (default 64000)
#   BA_REQUEST_TIMEOUT=300  seconds per request (default 300)
#   BA_EFFORT=medium        low | medium | high | xhigh | max (default high)

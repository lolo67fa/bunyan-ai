# Business Analyst Agent settings.
# Add the lines you need to the repository-root `.env` (copied from the root
# `.env.example`). NEVER commit `.env` or real API keys.

# "mock" (default: offline, free, deterministic) or "llm" (provider API, costs money).
# The backend (backend/main.py) reads it at startup; any other value stops it with a clear error.
BA_MODE=mock

# Optional per-agent model. If empty, the project-wide LLM_PROVIDER / LLM_MODEL are used.
# Provider is any LiteLLM prefix, e.g. anthropic, openai.
BA_LLM_PROVIDER=
BA_LLM_MODEL=

# How LLM mode calls the model: "crewai" (default, needs requirements-llm.txt) or
# "direct" (Anthropic SDK only, needs requirements-direct.txt; recommended for the app)
BA_LLM_BACKEND=crewai

# Anthropic effort for the direct backend: low | medium | high | xhigh | max
BA_EFFORT=high

# Extra attempts when the LLM output fails validation (default 2)
BA_MAX_RETRIES=2

# Direct backend only. Server-side refusal fallback: "on" (default) re-runs a refused
# request on another model (a second, billed attempt); "off" returns the refusal instead.
BA_FALLBACKS=on

# Direct backend only. Anthropic SDK transport retries on 429/5xx/connection errors.
# Empty = SDK default (2). Set 0 for strictly one HTTP request per attempt.
BA_SDK_MAX_RETRIES=

# Direct backend only. Seconds before a model request is abandoned (default 300).
BA_REQUEST_TIMEOUT=300

# Direct backend only. Output token cap per request (default 64000). A full
# requirements document needs about 12-16k output tokens.
BA_MAX_TOKENS=64000

# Optional sampling temperature, forwarded to NON-Anthropic providers only
# (the Anthropic Messages API rejects temperature/top_p/top_k). Leave empty.
BA_TEMPERATURE=

# Print CrewAI agent logs (true/false)
BA_VERBOSE=false

# Set to 1 only when you intentionally want to run the paid live evaluations in evals/
BA_RUN_LLM_EVALS=0

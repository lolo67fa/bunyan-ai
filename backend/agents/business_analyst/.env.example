# Business Analyst Agent settings.
# Add the lines you need to the repository-root `.env` (copied from the root
# `.env.example`). NEVER commit `.env` or real API keys.

# "mock" (default: offline, free, deterministic) or "llm" (CrewAI + provider API, costs money)
BA_MODE=mock

# Optional per-agent model. If empty, the project-wide LLM_PROVIDER / LLM_MODEL are used.
# Provider is any LiteLLM prefix, e.g. anthropic, openai.
BA_LLM_PROVIDER=
BA_LLM_MODEL=

# How LLM mode calls the model: "crewai" (default, needs requirements-llm.txt) or
# "direct" (Anthropic SDK only; useful when CrewAI is not installed)
BA_LLM_BACKEND=crewai

# Anthropic effort for the direct backend: low | medium | high | xhigh | max
BA_EFFORT=high

# Extra attempts when the LLM output fails validation (default 2)
BA_MAX_RETRIES=2

# Optional sampling temperature, forwarded to NON-Anthropic providers only
# (the Anthropic Messages API rejects temperature/top_p/top_k). Leave empty.
BA_TEMPERATURE=

# Print CrewAI agent logs (true/false)
BA_VERBOSE=false

# Set to 1 only when you intentionally want to run the paid live evaluations in evals/
BA_RUN_LLM_EVALS=0

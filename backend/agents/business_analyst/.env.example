# Business Analyst Agent settings.
# Add the lines you need to the repository-root `.env` (copied from the root
# `.env.example`). NEVER commit `.env` or real API keys.

# "mock" (default: offline, free, deterministic) or "llm" (CrewAI + provider API, costs money)
BA_MODE=mock

# Optional per-agent model. If empty, the project-wide LLM_PROVIDER / LLM_MODEL are used.
# Provider is any LiteLLM prefix, e.g. anthropic, openai.
BA_LLM_PROVIDER=
BA_LLM_MODEL=

# Sampling temperature (default 0.2) and extra attempts when the LLM output fails validation (default 2)
BA_TEMPERATURE=0.2
BA_MAX_RETRIES=2

# Print CrewAI agent logs (true/false)
BA_VERBOSE=false

# Set to 1 only when you intentionally want to run the paid live evaluations in evals/
BA_RUN_LLM_EVALS=0

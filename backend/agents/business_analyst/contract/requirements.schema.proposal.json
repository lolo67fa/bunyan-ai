        "type": {
          "enum": [
            "string",
            "text",
            "integer",
            "decimal",
            "boolean",
            "date",
            "time",
            "datetime",
            "email",
            "phone",
            "url",
            "enum",
            "reference"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "enum_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"

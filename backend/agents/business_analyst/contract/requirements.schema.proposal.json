        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "validation": {
          "$ref": "#/$defs/ValidationRules"
        }
      },
      "required": [
        "name",
        "label",
        "type",
        "required"

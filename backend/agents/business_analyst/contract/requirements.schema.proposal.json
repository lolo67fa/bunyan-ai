          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "DeleteSpec",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "PascalCase English identifier, singular.",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "plural_label": {
          "minLength": 1,
          "title": "Plural Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "display_field": {

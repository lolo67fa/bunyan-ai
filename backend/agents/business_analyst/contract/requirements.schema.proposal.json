{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^AC-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "story_id": {
          "pattern": "^US-\\d+$",
          "title": "Story Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "create",
            "read",
            "update",
            "delete",
            "validation",
            "persistence",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "given": {
          "minLength": 5,
          "title": "Given",
          "type": "string"
        },
        "when": {
          "minLength": 5,
          "title": "When",
          "type": "string"
        },
        "then": {
          "description": "Observable, testable outcome (used by the QA Agent).",
          "minLength": 5,
          "title": "Then",
          "type": "string"
        }
      },
      "required": [
        "id",
        "story_id",
        "category",
        "given",
        "when",
        "then"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "AppInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 2,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "target_users": {
          "items": {
            "type": "string"
          },
          "title": "Target Users",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "AppInfo",
      "type": "object"
    },
    "ClarificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^Q-\\d+$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 5,
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "minLength": 5,
          "title": "Reason",
          "type": "string"
        },
        "blocking": {
          "description": "True if requirements cannot be finalised without an answer.",
          "title": "Blocking",
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "suggested_default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Default"
        }
      },
      "required": [
        "id",
        "question",
        "reason",
        "blocking"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "CrudSpec": {

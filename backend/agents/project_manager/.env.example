# Project Manager Agent settings. Put real values in the repository's git-ignored .env, never here.
# rules (default, free, deterministic) or llm (adds an executive summary and up to 3 extra risks)
PM_MODE=rules
# LLM mode only. Falls back to LLM_PROVIDER / LLM_MODEL when unset.
PM_LLM_PROVIDER=anthropic
PM_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
PM_EFFORT=medium
# The key itself goes in .env as ANTHROPIC_API_KEY (or the ANTHROPIC_API_KEY GitHub secret).

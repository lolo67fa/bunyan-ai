  "acceptance_criteria": [
   {
    "id": "AC-1",
    "story_id": "US-1",
    "category": "create",
    "given": "the Tasks list is open with N records",
    "when": "the user fills in Title = \"Prepare sprint report\", Priority = \"high\", Status = \"to_do\" and clicks \"Save\"",
    "then": "a Task named \"Prepare sprint report\" appears in the list and the list shows N + 1 records"
   },
   {
    "id": "AC-2",
    "story_id": "US-1",
    "category": "validation",
    "given": "the create Task form is open",
    "when": "the user leaves all fields empty and clicks \"Save\"",
    "then": "no Task is saved and an error message is shown next to each required field: Title, Priority, Status"
   },
   {
    "id": "AC-3",
    "story_id": "US-1",
    "category": "validation",
    "given": "the create Task form is open and all other fields are valid",
    "when": "the user enters the 2-character value \"ab\" in \"Title\" and clicks \"Save\"",
    "then": "the Task is not saved and an error message is shown next to \"Title\""
   },
   {
    "id": "AC-4",
    "story_id": "US-1",
    "category": "validation",
    "given": "the create Task form is open and all other fields are valid",
    "when": "the user enters a text of 1001 characters in \"Description\" and clicks \"Save\"",
    "then": "the Task is not saved and an error message is shown next to \"Description\""
   },
   {
    "id": "AC-5",
    "story_id": "US-1",
    "category": "validation",
    "given": "the create Task form is open and all other fields are valid",
    "when": "the user enters yesterday's date in \"Due date\" and clicks \"Save\"",
    "then": "the Task is not saved and an error message is shown next to \"Due date\""
   },
   {
    "id": "AC-6",
    "story_id": "US-1",
    "category": "persistence",
    "given": "a Task named \"Prepare sprint report\" was created",
    "when": "the user reloads the page",
    "then": "\"Prepare sprint report\" is still shown in the Tasks list with the same values"
   },
   {
    "id": "AC-7",
    "story_id": "US-2",
    "category": "read",
    "given": "3 Tasks have been created",
    "when": "the user opens the Tasks list",
    "then": "exactly 3 rows are shown, each with the columns Title, Due date, Priority, Status"
   },
   {
    "id": "AC-8",
    "story_id": "US-2",
    "category": "read",
    "given": "no Tasks exist",
    "when": "the user opens the Tasks list",
    "then": "an empty-state message is shown instead of the list"
   },
   {
    "id": "AC-9",
    "story_id": "US-2",
    "category": "read",
    "given": "Tasks named \"Prepare sprint report\" and \"Other record\" exist",
    "when": "the user types \"Prepare sprint report\" in the search box",
    "then": "only the Task \"Prepare sprint report\" is shown in the list"
   },
   {
    "id": "AC-10",
    "story_id": "US-3",
    "category": "update",
    "given": "a Task named \"Prepare sprint report\" exists",
    "when": "the user changes Title to \"Prepare sprint report (edited)\", clicks \"Save\" and reloads the page",
    "then": "the list shows \"Prepare sprint report (edited)\" and no longer shows \"Prepare sprint report\""
   },
   {
    "id": "AC-11",
    "story_id": "US-3",
    "category": "validation",
    "given": "a Task named \"Prepare sprint report\" exists",
    "when": "the user clears Title in the edit form and clicks \"Save\"",
    "then": "the change is not saved, an error message is shown and the list still shows \"Prepare sprint report\""
   },
   {
    "id": "AC-12",
    "story_id": "US-4",
    "category": "delete",
    "given": "a Task named \"Prepare sprint report\" exists and the list shows N records",
    "when": "the user clicks \"Delete\" on it and confirms",
    "then": "\"Prepare sprint report\" is removed from the list, the list shows N - 1 records, and it is still absent after reloading the page"
   },
   {
    "id": "AC-13",
    "story_id": "US-4",
    "category": "delete",
    "given": "a Task named \"Prepare sprint report\" exists",
    "when": "the user clicks \"Delete\" on it and cancels the confirmation",
    "then": "\"Prepare sprint report\" is still shown in the list"
   }
  ],

  "functional_requirements": [
   {
    "id": "FR-1",
    "entity": "Task",
    "category": "create",
    "description": "The system shall allow the user to create a Task by entering: Title, Description, Due date, Priority, Status.",
    "priority": "must"
   },
   {
    "id": "FR-2",
    "entity": "Task",
    "category": "read",
    "description": "The system shall display all Tasks in a list showing Title, Due date, Priority, Status, sorted by Due date, with search by Title and filters by Status, Priority.",
    "priority": "must"
   },
   {
    "id": "FR-3",
    "entity": "Task",
    "category": "update",
    "description": "The system shall allow the user to edit any field of an existing Task and save the changes.",
    "priority": "must"
   },
   {
    "id": "FR-4",
    "entity": "Task",
    "category": "delete",
    "description": "The system shall allow the user to delete a Task after confirming the action in a confirmation dialog.",
    "priority": "must"
   },
   {
    "id": "FR-5",
    "entity": "Task",
    "category": "validation",
    "description": "The system shall reject saving a Task unless: Title is filled in, Title has at least 3 characters, Title has at most 100 characters, Description has at most 1000 characters, Due date is today or later, Priority is filled in, Status is filled in.",
    "priority": "must"
   },

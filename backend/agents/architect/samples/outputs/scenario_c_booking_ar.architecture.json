{
  "schema_version": "0.3.0-proposal",
  "source": {
    "requirements_schema_version": "0.1.0-proposal"
  },
  "app": {
    "name": "إدارة الحجوزات",
    "description": "تطبيق ويب بسيط لإضافة الحجوزات وعرضها وتعديل مواعيدها وإلغائها مع اسم العميل والتاريخ والوقت والحالة.",
    "language": "ar",
    "direction": "rtl"
  },
  "entity": {
    "name": "Booking",
    "label": "حجز",
    "plural_label": "الحجوزات",
    "display_field": "customer_name",
    "storage": {
      "engine": "localStorage",
      "key": "bunyan_booking",
      "id_field": "id",
      "id_strategy": "uuid",
      "system_fields": [
        "id",
        "created_at",
        "updated_at"
      ]
    },
    "fields": [
      {
        "name": "customer_name",
        "label": "اسم العميل",
        "type": "string",
        "input": "text",
        "required": true,
        "unique": false,
        "validation": {
          "min_length": 2,
          "max_length": 100
        },
        "messages": {
          "required": "اسم العميل: هذا الحقل مطلوب",
          "min_length": "اسم العميل: يجب إدخال 2 أحرف على الأقل",
          "max_length": "اسم العميل: الحد الأقصى 100 حرفًا"
        },
        "show_in_list": true
      },
      {
        "name": "date",
        "label": "التاريخ",
        "type": "date",
        "input": "date",
        "required": true,
        "unique": false,
        "validation": {
          "date_constraint": "not_in_past"
        },
        "messages": {
          "required": "التاريخ: هذا الحقل مطلوب",
          "date_constraint": "التاريخ: لا يمكن اختيار تاريخ سابق"
        },
        "show_in_list": true
      },
      {
        "name": "time",
        "label": "الوقت",
        "type": "time",
        "input": "time",
        "required": true,
        "unique": false,
        "validation": {},
        "messages": {
          "required": "الوقت: هذا الحقل مطلوب"
        },
        "show_in_list": true
      },
      {
        "name": "status",
        "label": "حالة الحجز",
        "type": "enum",
        "input": "select",
        "required": true,
        "unique": false,
        "default": "مؤكد",
        "options": [
          {
            "value": "مؤكد",
            "label": "مؤكد"
          },
          {
            "value": "ملغى",
            "label": "ملغى"
          }
        ],
        "validation": {},
        "messages": {
          "required": "حالة الحجز: هذا الحقل مطلوب"
        },
        "show_in_list": true
      },
      {
        "name": "notes",
        "label": "ملاحظات",
        "type": "text",
        "input": "textarea",
        "required": false,
        "unique": false,
        "validation": {
          "max_length": 500
        },
        "messages": {
          "max_length": "ملاحظات: الحد الأقصى 500 حرفًا"
        },
        "show_in_list": false
      }
    ]
  },
  "screens": [
    {
      "id": "list",
      "type": "list",
      "title": "الحجوزات",
      "components": [
        {
          "type": "header"
        },
        {
          "type": "add_button",
          "label": "إضافة حجز"
        },
        {
          "type": "search",
          "fields": [
            "customer_name"
          ],
          "placeholder": "بحث في الحجوزات"
        },
        {
          "type": "filters",
          "fields": [
            "status",
            "date"
          ]
        },
        {
          "type": "table",
          "columns": [
            "customer_name",
            "date",
            "time",
            "status"
          ],
          "sort": {
            "field": "date",
            "direction": "asc"
          },
          "row_actions": [
            "edit",
            "delete"
          ]
        },
        {
          "type": "empty_state"
        }
      ]
    },
    {
      "id": "form",
      "type": "form",
      "title": "بيانات حجز",
      "modes": [
        "create",
        "edit"
      ],
      "components": [
        {
          "type": "form_fields",
          "fields": [
            "customer_name",
            "date",
            "time",
            "status",
            "notes"
          ]
        },
        {
          "type": "save_button",
          "label": "حفظ"
        },
        {
          "type": "cancel_button",
          "label": "إلغاء"
        }
      ]
    }
  ],
  "navigation": {
    "initial_screen": "list",
    "transitions": [
      {
        "from": "list",
        "event": "add",
        "to": "form",
        "mode": "create"
      },
      {
        "from": "list",
        "event": "edit",
        "to": "form",
        "mode": "edit"
      },
      {
        "from": "form",
        "event": "save_success",
        "to": "list"
      },
      {
        "from": "form",
        "event": "cancel",
        "to": "list"
      }
    ]
  },
  "behaviors": {
    "validate_before_save": true,
    "check_unique_before_save": false,
    "prefill_form_on_edit": true,
    "load_on_start": true,
    "delete_confirmation": "inline",
    "after_save": "show_message_and_return_to_list",
    "after_delete": "remove_row_and_show_message"
  },
  "messages": {
    "empty": "لا توجد سجلات بعد.",
    "no_results": "لا توجد نتائج مطابقة للبحث.",
    "invalid": "القيمة غير صحيحة",
    "created": "تمت الإضافة بنجاح",
    "updated": "تم حفظ التعديلات",
    "deleted": "تم الحذف",
    "confirm_delete": "هل تريد حذف «{display}»؟",
    "confirm_button": "تأكيد الحذف",
    "cancel_delete_button": "تراجع",
    "edit_button": "تعديل",
    "delete_button": "حذف"
  },
  "verbatim_messages": [
    {
      "path": "messages.delete_button",
      "text": "حذف",
      "source": "AC-13"
    },
    {
      "path": "screens.form.save_button",
      "text": "حفظ",
      "source": "AC-1"
    }
  ],
  "deferred_rules": [],
  "warnings": []
}

{
  "schema_version": "0.2.0-proposal",
  "source": {
    "requirements_schema_version": "0.1.0-proposal"
  },
  "app": {
    "name": "Task Manager",
    "description": "A single-user web app to create, track, update and delete personal tasks with due dates, priority and status.",
    "language": "en",
    "direction": "ltr"
  },
  "entity": {
    "name": "Task",
    "label": "Task",
    "plural_label": "Tasks",
    "display_field": "title",
    "storage": {
      "engine": "localStorage",
      "key": "bunyan_task",
      "id_field": "id",
      "id_strategy": "uuid",
      "system_fields": [
        "id",
        "created_at",
        "updated_at"
      ]
    },
    "fields": [
      {
        "name": "title",
        "label": "Title",
        "type": "string",
        "input": "text",
        "required": true,
        "unique": false,
        "validation": {
          "min_length": 3,
          "max_length": 100
        },
        "show_in_list": true
      },
      {
        "name": "description",
        "label": "Description",
        "type": "text",
        "input": "textarea",
        "required": false,
        "unique": false,
        "validation": {
          "max_length": 1000
        },
        "show_in_list": false
      },
      {
        "name": "due_date",
        "label": "Due date",
        "type": "date",
        "input": "date",
        "required": false,
        "unique": false,
        "validation": {
          "date_constraint": "not_in_past"
        },
        "show_in_list": true
      },
      {
        "name": "priority",
        "label": "Priority",
        "type": "enum",
        "input": "select",
        "required": true,
        "unique": false,
        "default": "medium",
        "options": [
          {
            "value": "low",
            "label": "Low"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "high",
            "label": "High"
          }
        ],
        "validation": {},
        "show_in_list": true
      },
      {
        "name": "status",
        "label": "Status",
        "type": "enum",
        "input": "select",
        "required": true,
        "unique": false,
        "default": "to_do",
        "options": [
          {
            "value": "to_do",
            "label": "To do"
          },
          {
            "value": "in_progress",
            "label": "In progress"
          },
          {
            "value": "done",
            "label": "Done"
          }
        ],
        "validation": {},
        "show_in_list": true
      }
    ]
  },
  "screens": [
    {
      "id": "list",
      "type": "list",
      "title": "Tasks",
      "components": [
        {
          "type": "header"
        },
        {
          "type": "add_button",
          "label": "Add Task"
        },
        {
          "type": "search",
          "fields": [
            "title"
          ],
          "placeholder": "Search Tasks"
        },
        {
          "type": "filters",
          "fields": [
            "status",
            "priority"
          ]
        },
        {
          "type": "table",
          "columns": [
            "title",
            "due_date",
            "priority",
            "status"
          ],
          "sort": {
            "field": "due_date",
            "direction": "asc"
          },
          "row_actions": [
            "edit",
            "delete"
          ]
        },
        {
          "type": "empty_state"
        }
      ]
    },
    {
      "id": "form",
      "type": "form",
      "title": "Task details",
      "modes": [
        "create",
        "edit"
      ],
      "components": [
        {
          "type": "form_fields",
          "fields": [
            "title",
            "description",
            "due_date",
            "priority",
            "status"
          ]
        },
        {
          "type": "save_button",
          "label": "Save"
        },
        {
          "type": "cancel_button",
          "label": "Cancel"
        }
      ]
    }
  ],
  "navigation": {
    "initial_screen": "list",
    "transitions": [
      {
        "from": "list",
        "event": "add",
        "to": "form",
        "mode": "create"
      },
      {
        "from": "list",
        "event": "edit",
        "to": "form",
        "mode": "edit"
      },
      {
        "from": "form",
        "event": "save_success",
        "to": "list"
      },
      {
        "from": "form",
        "event": "cancel",
        "to": "list"
      }
    ]
  },
  "behaviors": {
    "validate_before_save": true,
    "check_unique_before_save": false,
    "prefill_form_on_edit": true,
    "load_on_start": true,
    "delete_confirmation": "inline",
    "after_save": "show_message_and_return_to_list",
    "after_delete": "remove_row_and_show_message"
  },
  "messages": {
    "empty": "No Tasks yet.",
    "required": "This field is required",
    "invalid": "Invalid value",
    "unique": "This value is already in use",
    "created": "Added successfully",
    "updated": "Changes saved",
    "deleted": "Deleted",
    "confirm_delete": "Delete “{display}”?",
    "confirm_button": "Confirm delete",
    "cancel_delete_button": "Keep",
    "edit_button": "Edit",
    "delete_button": "Delete"
  },
  "deferred_rules": [],
  "warnings": []
}

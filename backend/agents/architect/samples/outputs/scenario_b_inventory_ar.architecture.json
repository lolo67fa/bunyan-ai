{
  "schema_version": "0.3.0-proposal",
  "source": {
    "requirements_schema_version": "0.1.0-proposal"
  },
  "app": {
    "name": "مدير المخزون",
    "description": "تطبيق ويب لمتجر صغير لتسجيل المنتجات مع كمياتها وأسعارها وتعديلها وحذفها.",
    "language": "ar",
    "direction": "rtl"
  },
  "entity": {
    "name": "Product",
    "label": "منتج",
    "plural_label": "المنتجات",
    "display_field": "name",
    "storage": {
      "engine": "localStorage",
      "key": "bunyan_product",
      "id_field": "id",
      "id_strategy": "uuid",
      "system_fields": [
        "id",
        "created_at",
        "updated_at"
      ]
    },
    "fields": [
      {
        "name": "name",
        "label": "اسم المنتج",
        "type": "string",
        "input": "text",
        "required": true,
        "unique": false,
        "validation": {
          "min_length": 2,
          "max_length": 100
        },
        "messages": {
          "required": "اسم المنتج: هذا الحقل مطلوب",
          "min_length": "اسم المنتج: يجب إدخال 2 أحرف على الأقل",
          "max_length": "اسم المنتج: الحد الأقصى 100 حرفًا"
        },
        "show_in_list": true
      },
      {
        "name": "quantity",
        "label": "الكمية",
        "type": "integer",
        "input": "number",
        "required": true,
        "unique": false,
        "default": 0,
        "step": 1.0,
        "display_format": {
          "decimals": 0
        },
        "validation": {
          "min_value": 0.0
        },
        "messages": {
          "required": "الكمية: هذا الحقل مطلوب",
          "min_value": "الكمية: أقل قيمة مسموحة 0"
        },
        "show_in_list": true
      },
      {
        "name": "price",
        "label": "السعر",
        "type": "decimal",
        "input": "number",
        "required": true,
        "unique": false,
        "step": 0.01,
        "display_format": {
          "decimals": 2
        },
        "validation": {
          "min_value": 0.0
        },
        "messages": {
          "required": "السعر: هذا الحقل مطلوب",
          "min_value": "السعر: أقل قيمة مسموحة 0"
        },
        "show_in_list": true
      }
    ]
  },
  "screens": [
    {
      "id": "list",
      "type": "list",
      "title": "المنتجات",
      "components": [
        {
          "type": "header"
        },
        {
          "type": "add_button",
          "label": "إضافة منتج"
        },
        {
          "type": "search",
          "fields": [
            "name"
          ],
          "placeholder": "بحث في المنتجات"
        },
        {
          "type": "table",
          "columns": [
            "name",
            "quantity",
            "price"
          ],
          "sort": {
            "field": "name",
            "direction": "asc"
          },
          "row_actions": [
            "edit",
            "delete"
          ]
        },
        {
          "type": "empty_state"
        }
      ]
    },
    {
      "id": "form",
      "type": "form",
      "title": "بيانات منتج",
      "modes": [
        "create",
        "edit"
      ],
      "components": [
        {
          "type": "form_fields",
          "fields": [
            "name",
            "quantity",
            "price"
          ]
        },
        {
          "type": "save_button",
          "label": "حفظ"
        },
        {
          "type": "cancel_button",
          "label": "إلغاء"
        }
      ]
    }
  ],
  "navigation": {
    "initial_screen": "list",
    "transitions": [
      {
        "from": "list",
        "event": "add",
        "to": "form",
        "mode": "create"
      },
      {
        "from": "list",
        "event": "edit",
        "to": "form",
        "mode": "edit"
      },
      {
        "from": "form",
        "event": "save_success",
        "to": "list"
      },
      {
        "from": "form",
        "event": "cancel",
        "to": "list"
      }
    ]
  },
  "behaviors": {
    "validate_before_save": true,
    "check_unique_before_save": false,
    "prefill_form_on_edit": true,
    "load_on_start": true,
    "delete_confirmation": "inline",
    "after_save": "show_message_and_return_to_list",
    "after_delete": "remove_row_and_show_message"
  },
  "messages": {
    "empty": "لا توجد سجلات بعد.",
    "no_results": "لا توجد نتائج مطابقة للبحث.",
    "invalid": "القيمة غير صحيحة",
    "created": "تمت الإضافة بنجاح",
    "updated": "تم حفظ التعديلات",
    "deleted": "تم الحذف",
    "confirm_delete": "هل تريد حذف «{display}»؟",
    "confirm_button": "تأكيد الحذف",
    "cancel_delete_button": "تراجع",
    "edit_button": "تعديل",
    "delete_button": "حذف"
  },
  "verbatim_messages": [
    {
      "path": "messages.delete_button",
      "text": "حذف",
      "source": "AC-12"
    },
    {
      "path": "screens.form.save_button",
      "text": "حفظ",
      "source": "AC-1"
    }
  ],
  "deferred_rules": [],
  "warnings": []
}

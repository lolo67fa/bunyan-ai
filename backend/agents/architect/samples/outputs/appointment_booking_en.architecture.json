{
  "schema_version": "0.3.0-proposal",
  "source": {
    "requirements_schema_version": "0.1.0-proposal"
  },
  "app": {
    "name": "Appointment Booking",
    "description": "A web app for a small clinic receptionist to book, view, reschedule and cancel client appointments.",
    "language": "en",
    "direction": "ltr"
  },
  "entity": {
    "name": "Appointment",
    "label": "Appointment",
    "plural_label": "Appointments",
    "display_field": "client_name",
    "storage": {
      "engine": "localStorage",
      "key": "bunyan_appointment",
      "id_field": "id",
      "id_strategy": "uuid",
      "system_fields": [
        "id",
        "created_at",
        "updated_at"
      ]
    },
    "fields": [
      {
        "name": "client_name",
        "label": "Client name",
        "type": "string",
        "input": "text",
        "required": true,
        "unique": false,
        "validation": {
          "min_length": 2,
          "max_length": 100
        },
        "messages": {
          "required": "Client name is required",
          "min_length": "Client name must be at least 2 characters",
          "max_length": "Client name must be at most 100 characters"
        },
        "show_in_list": true
      },
      {
        "name": "client_phone",
        "label": "Client phone",
        "type": "phone",
        "input": "tel",
        "required": true,
        "unique": false,
        "validation": {
          "pattern": "^\\+?[0-9]{9,15}$"
        },
        "messages": {
          "required": "Client phone is required",
          "pattern": "Client phone format is invalid"
        },
        "show_in_list": false
      },
      {
        "name": "service",
        "label": "Service",
        "type": "enum",
        "input": "select",
        "required": true,
        "unique": false,
        "options": [
          {
            "value": "consultation",
            "label": "Consultation"
          },
          {
            "value": "follow_up",
            "label": "Follow up"
          },
          {
            "value": "check_up",
            "label": "Check up"
          }
        ],
        "empty_option": "Select Service",
        "validation": {},
        "messages": {
          "required": "Service is required"
        },
        "show_in_list": true
      },
      {
        "name": "date",
        "label": "Date",
        "type": "date",
        "input": "date",
        "required": true,
        "unique": false,
        "validation": {
          "date_constraint": "not_in_past"
        },
        "messages": {
          "required": "Date is required",
          "date_constraint": "Date cannot be in the past"
        },
        "show_in_list": true
      },
      {
        "name": "time",
        "label": "Time",
        "type": "time",
        "input": "time",
        "required": true,
        "unique": false,
        "validation": {},
        "messages": {
          "required": "Time is required"
        },
        "show_in_list": true
      },
      {
        "name": "duration_minutes",
        "label": "Duration (minutes)",
        "type": "integer",
        "input": "number",
        "required": true,
        "unique": false,
        "default": 30,
        "step": 1.0,
        "display_format": {
          "decimals": 0
        },
        "validation": {
          "min_value": 15.0,
          "max_value": 240.0
        },
        "messages": {
          "required": "Duration (minutes) is required",
          "min_value": "Duration (minutes) must be 15 or more",
          "max_value": "Duration (minutes) must be 240 or less"
        },
        "show_in_list": false
      },
      {
        "name": "status",
        "label": "Status",
        "type": "enum",
        "input": "select",
        "required": true,
        "unique": false,
        "default": "scheduled",
        "options": [
          {
            "value": "scheduled",
            "label": "Scheduled"
          },
          {
            "value": "completed",
            "label": "Completed"
          },
          {
            "value": "cancelled",
            "label": "Cancelled"
          }
        ],
        "validation": {},
        "messages": {
          "required": "Status is required"
        },
        "show_in_list": true
      },
      {
        "name": "notes",
        "label": "Notes",
        "type": "text",
        "input": "textarea",
        "required": false,
        "unique": false,
        "validation": {
          "max_length": 500
        },
        "messages": {
          "max_length": "Notes must be at most 500 characters"
        },
        "show_in_list": false
      }
    ]
  },
  "screens": [
    {
      "id": "list",
      "type": "list",
      "title": "Appointments",
      "components": [
        {
          "type": "header"
        },
        {
          "type": "add_button",
          "label": "Add Appointment"
        },
        {
          "type": "search",
          "fields": [
            "client_name",
            "client_phone"
          ],
          "placeholder": "Search Appointments"
        },
        {
          "type": "filters",
          "fields": [
            "status",
            "service",
            "date"
          ]
        },
        {
          "type": "table",
          "columns": [
            "client_name",
            "date",
            "time",
            "service",
            "status"
          ],
          "sort": {
            "field": "date",
            "direction": "asc"
          },
          "row_actions": [
            "edit",
            "delete"
          ]
        },
        {
          "type": "empty_state"
        }
      ]
    },
    {
      "id": "form",
      "type": "form",
      "title": "Appointment details",
      "modes": [
        "create",
        "edit"
      ],
      "components": [
        {
          "type": "form_fields",
          "fields": [
            "client_name",
            "client_phone",
            "service",
            "date",
            "time",
            "duration_minutes",
            "status",
            "notes"
          ]
        },
        {
          "type": "save_button",
          "label": "Save"
        },
        {
          "type": "cancel_button",
          "label": "Cancel"
        }
      ]
    }
  ],
  "navigation": {
    "initial_screen": "list",
    "transitions": [
      {
        "from": "list",
        "event": "add",
        "to": "form",
        "mode": "create"
      },
      {
        "from": "list",
        "event": "edit",
        "to": "form",
        "mode": "edit"
      },
      {
        "from": "form",
        "event": "save_success",
        "to": "list"
      },
      {
        "from": "form",
        "event": "cancel",
        "to": "list"
      }
    ]
  },
  "behaviors": {
    "validate_before_save": true,
    "check_unique_before_save": false,
    "prefill_form_on_edit": true,
    "load_on_start": true,
    "delete_confirmation": "inline",
    "after_save": "show_message_and_return_to_list",
    "after_delete": "remove_row_and_show_message"
  },
  "messages": {
    "empty": "No records yet.",
    "no_results": "No records match your search.",
    "invalid": "Invalid value",
    "created": "Added successfully",
    "updated": "Changes saved",
    "deleted": "Deleted",
    "confirm_delete": "Delete “{display}”?",
    "confirm_button": "Confirm delete",
    "cancel_delete_button": "Keep",
    "edit_button": "Edit",
    "delete_button": "Delete"
  },
  "verbatim_messages": [
    {
      "path": "messages.delete_button",
      "text": "Delete",
      "source": "AC-15"
    },
    {
      "path": "screens.form.save_button",
      "text": "Save",
      "source": "AC-1"
    }
  ],
  "deferred_rules": [],
  "warnings": [
    "AC-8 quotes the message “This time slot is already booked” but it is not tied to one field rule (likely a business rule such as no double booking); the MVP template cannot show it"
  ]
}
